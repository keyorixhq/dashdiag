#!/bin/bash
# Pre-commit: fast checks only — gofmt/vet are near-instant; the -short test
# run is the long pole (typically ~50-55s, hard-capped at 300s, see below)
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e
echo "→ Pre-commit (fast checks)"

# 1. Secret scanning — staged diff only, instant. Enforces the
# never-commit-private-config rule as a gate rather than a discipline.
if command -v gitleaks &>/dev/null; then
    if ! gitleaks protect --staged --no-banner 2>&1; then
        echo "❌ gitleaks found a potential secret in the staged diff"
        exit 1
    fi
    echo "  ✅ gitleaks"
else
    echo "  ⚠️  gitleaks not installed — brew install gitleaks (skipping)"
fi

# 2. Format check — staged .go files only, instant. NOT `gofmt -l .`: gofmt
# walks the raw filesystem with no .gitignore awareness (unlike `go vet
# ./...`/`go test ./...` below, which are module-scoped and skip dot-dirs
# automatically), so on a dev machine with an accumulated .scratch/ or
# .claude/worktrees/ tree it recurses into thousands of unrelated/malformed
# .go files (vendored module caches, scratch experiments) and can never pass.
staged_go_files="$(git diff --cached --name-only --diff-filter=ACM -- '*.go')"
if [ -n "$staged_go_files" ]; then
    unformatted="$(gofmt -l $staged_go_files)"
    if [ -n "$unformatted" ]; then
        echo ""
        echo "❌ Files need formatting. Run: make fmt"
        echo ""
        echo "$unformatted"
        exit 1
    fi
fi
echo "  ✅ gofmt"

# 3. go vet — 2-5 seconds, catches real bugs
if ! go vet ./... 2>&1; then
    echo "❌ go vet failed"
    exit 1
fi
echo "  ✅ go vet"

# 4. Tests with -short flag — skips slow integration tests. Budget matches
# CI's own timeout (300s, see ci.yml `go test -race ... -timeout 300s`): the
# cmd package's test suite alone now regularly takes 45-55s even under
# -short (its every-subcommand-spawns-a-subprocess smoke tests already skip
# under -short — see cmd/smoke_test.go — but the remaining ~1200 in-process
# tests in that package are enough on their own to blow a 60s ceiling under
# load), so a flat 60s ceiling here was intermittently killing the whole
# `go test` run on unrelated commits, not just slow ones (issue #1108).
if ! go test -short -count=1 -timeout 300s ./... 2>&1; then
    echo "❌ Tests failed"
    exit 1
fi
echo "  ✅ tests (short)"

echo ""
echo "✅ Pre-commit passed — run 'make check' for full lint before pushing"
