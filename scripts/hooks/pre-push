#!/bin/bash
# Pre-push: thorough checks before code reaches GitHub
# Install: cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

set -e
echo "→ Pre-push (thorough checks)"

# 1. Full test suite with race detector
echo "  Running tests with race detector..."
if ! go test -race -count=1 -timeout 300s ./... 2>&1; then
    echo "❌ Tests failed (race detector)"
    exit 1
fi
echo "  ✅ tests (race)"

# 2. golangci-lint — full linter suite. On a non-Linux dev machine this
# lints for the HOST's GOOS, so any symbol whose only real callers live in a
# _linux.go (or //go:build linux) file falsely reports as `unused` -- CI
# always lints on a real Linux runner and never sees this. If this step
# fails ONLY with `unused` findings pointing at Linux-only files, that's
# expected noise, not a real bug: use `make lint-linux` (real Linux
# container) instead before pushing Linux-collector changes.
if command -v golangci-lint &>/dev/null; then
    echo "  Running golangci-lint..."
    if ! golangci-lint run ./... 2>&1; then
        echo "❌ golangci-lint failed"
        echo "   Fix issues, or if they're all 'unused' findings in _linux.go files,"
        echo "   re-check with: make lint-linux"
        exit 1
    fi
    echo "  ✅ golangci-lint"
else
    echo "  ⚠️  golangci-lint not installed — run: make tools"
    echo "  Skipping lint check"
fi

# 3. staticcheck (if installed)
if command -v staticcheck &>/dev/null; then
    echo "  Running staticcheck..."
    if ! staticcheck ./... 2>&1; then
        echo "❌ staticcheck failed"
        exit 1
    fi
    echo "  ✅ staticcheck"
fi

# 4. gosec via golangci-lint — single source of truth for excludes is
# .golangci.yml (no standalone exclude list to drift; ADR-0007 lesson).
if command -v golangci-lint &>/dev/null; then
    echo "  Running gosec (via golangci-lint config)..."
    if ! golangci-lint run --enable-only=gosec ./... 2>&1; then
        echo "❌ gosec found security issues"
        exit 1
    fi
    echo "  ✅ gosec"
fi

# 5. semgrep custom rules — blocking set (ERROR+WARNING), mirrors CI.
# The INFO audit layer is intentionally excluded here; run `make security-audit`.
# Resolve paths from the repo root so the hook works regardless of git's CWD.
if command -v semgrep &>/dev/null; then
    echo "  Running semgrep (custom rules, blocking set)..."
    ROOT="$(git rev-parse --show-toplevel)"
    if ! semgrep scan --config "$ROOT/.semgrep/" --error --severity ERROR --severity WARNING --quiet "$ROOT" 2>/dev/null; then
        echo "❌ semgrep found security issues"
        exit 1
    fi
    echo "  ✅ semgrep"
else
    echo "  ⚠️  semgrep not installed — brew install semgrep (skipping)"
fi

# 6. govulncheck — dependency vuln scanning (SSDLC, ADR-0007). GOPATH/bin is
# not on the interactive PATH here, so `command -v` would silently skip this
# and defeat the check — resolve the binary by its full install path instead.
GOVULNCHECK="$(go env GOPATH)/bin/govulncheck"
if [ ! -x "$GOVULNCHECK" ]; then
    echo "  Installing govulncheck..."
    # Pinned, not @latest (OSSF Scorecard Pinned-Dependencies) — bump deliberately.
    go install golang.org/x/vuln/cmd/govulncheck@v1.5.0
fi
echo "  Running govulncheck..."
if ! "$GOVULNCHECK" ./... 2>&1; then
    echo "❌ govulncheck found a reachable vulnerability"
    exit 1
fi
echo "  ✅ govulncheck"

# 7. base-branch check: WARN (never block) if the branch being pushed has an
# already-open PR based on something other than main.
#
# Why: a PR based on a feature branch instead of main, once merged, lands its
# commits into THAT branch's history, not main's -- GitHub still reports the
# PR as "Merged" (the merge into the wrong base genuinely happened), so it
# looks done. Found for real in the sibling keyorix repo (#1961): a PR opened
# correctly against a feature branch and labeled for deliberate stacking,
# still open against that base after the feature branch had already landed
# on main under a different PR -- its own commit never reached main even
# though GitHub showed it Merged. Nothing here prevents the INITIAL mistake
# (no git hook runs at `gh pr create` time, and the base is a GitHub-side PR
# property this can only read after the fact) -- it catches a LATER push to
# a branch whose already-open PR still has a non-main base, ideally the
# moment just before that branch merges.
#
# WARNING, not a hard failure, unlike every other check above -- deliberate:
# a legitimate stacked PR still correctly waiting on its base to merge is
# indistinguishable, from git alone, from one whose base already merged and
# should have been retargeted, and blocking every push on every stack until
# it's marked would be far more disruptive than the mistake this catches.
# Escape hatch for a deliberate, still-in-progress stack: name the branch
# `stacked-on-...`, or add a `Stacked-On: <branch>` line to the latest
# commit's body. Skips silently if `gh`/`jq` aren't available or `gh` isn't
# authenticated -- never blocks a push over a missing local tool.
branch="$(git symbolic-ref --short -q HEAD || true)"
case "$branch" in
  ""|stacked-on-*) : ;;
  *)
    if command -v gh &>/dev/null && command -v jq &>/dev/null \
      && gh auth status &>/dev/null; then
      if ! git log -1 --format=%B HEAD 2>/dev/null | grep -qE '^Stacked-On:'; then
        pr_json="$(gh pr view "$branch" --json number,baseRefName,state 2>/dev/null || true)"
        if [ -n "$pr_json" ]; then
          pr_state="$(printf '%s' "$pr_json" | jq -r '.state')"
          pr_base="$(printf '%s' "$pr_json" | jq -r '.baseRefName')"
          pr_number="$(printf '%s' "$pr_json" | jq -r '.number')"
          if [ "$pr_state" = "OPEN" ] && [ "$pr_base" != "main" ]; then
            if git ls-remote --exit-code --heads origin "$pr_base" &>/dev/null; then
              echo "⚠️  PR #$pr_number for branch '$branch' is based on '$pr_base', not main."
              echo "   If '$pr_base' merges before this PR does and nobody retargets first,"
              echo "   this PR's commits never reach main even though GitHub will show it Merged."
            else
              echo "⚠️  PR #$pr_number for branch '$branch' is based on '$pr_base', which NO LONGER"
              echo "   EXISTS on the remote -- its own PR very likely already merged. This stack"
              echo "   was probably never retargeted; retarget #$pr_number to main before merging it."
            fi
            echo "   Deliberate, still-in-progress stack: name the branch 'stacked-on-...', or add"
            echo "   a 'Stacked-On: $pr_base' line to the latest commit body, to silence this."
          fi
        fi
      fi
    fi
    ;;
esac

echo ""
echo "✅ Pre-push passed — pushing to GitHub"
